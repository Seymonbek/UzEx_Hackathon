# Google Gemini API Kalitlari (Bir nechta kalit qo'yish mumkin! Vergul bilan ajrating)
# Bittasi limitga (429/Quota) tushsa, tizim AVTOMATIK keyingisiga o'tib ketaveradi!
GEMINI_API_KEYS=YOUR_GEMINI_KEY_1, YOUR_GEMINI_KEY_2, YOUR_GEMINI_KEY_3
# Yoki bitta kalit:
# GEMINI_API_KEY=AIzaSy...

UZEX_MODEL=gemini-2.5-flash

