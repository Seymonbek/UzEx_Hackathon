# LLM provayder: groq (tavsiya etiladi - o'ta tezkor) | openrouter | openai | gemini
LLM_PROVIDER=groq

# Groq API Kalitlari (Bir nechta kalit qo'yish mumkin! Vergul bilan ajrating)
# Bittasi limitga tushsa, tizim AVTOMATIK keyingisiga o'tib ketaveradi!
GROQ_API_KEYS=gsk_your_groq_key_1, gsk_your_groq_key_2

# Tavsiya etilgan eng tezkor va aniq model:
UZEX_MODEL=openai/gpt-oss-20b

# Telegram Bot Token (@BotFather dan olingan token)
TELEGRAM_BOT_TOKEN=8890541808:AAGyIE7oeIaJ_NBQY3y4IOXVA1dkdAF73Qs

# Veb ilova manzili (Telegram bot ichidagi Web App tugmasi uchun)
UZEX_WEBAPP_URL=https://your-domain.com
